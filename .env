# Django
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-me
ALLOWED_HOSTS=*

# База данных (PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=molvest
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=127.0.0.1
DB_PORT=5432

# Ключ, которым контроллеры ОВЕН авторизуются при отправке данных на /api/v1/counter/
CONTROLLER_API_KEY=super-secret-controller-key

# Временная зона предприятия
APP_TIME_ZONE=Europe/Moscow
